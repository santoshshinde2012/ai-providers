{
  "name": "ai-providers",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Canonical OpenAI-compatible protocol and per-provider strategy adapters for structured-output chat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santoshshinde2012/ai-providers.git"
  },
  "bugs": {
    "url": "https://github.com/santoshshinde2012/ai-providers/issues"
  },
  "homepage": "https://github.com/santoshshinde2012/ai-providers#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "rust",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "Cargo.toml",
    "Cargo.lock"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:rust": "cargo test --locked",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
