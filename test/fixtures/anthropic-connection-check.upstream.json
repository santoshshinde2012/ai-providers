{
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "Content-Type": "application/json",
    "X-API-Key": "sk-ant-test-key-not-used-live",
    "anthropic-version": "2026-10-21"
  },
  "body": {
    "model": "claude-opus-5-5",
    "max_tokens": 256,
    "system": [
      {
        "type": "text",
        "text": "Return the schema only."
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "Ping."
      }
    ],
    "output_config": {
      "format": {
        "type": "json_schema",
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "choice": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": ["ok"],
          "additionalProperties": false
        }
      },
      "effort": "low"
    }
  }
}
