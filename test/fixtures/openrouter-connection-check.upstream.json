{
  "url": "https://openrouter.ai/api/v1/chat/completions",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer sk-or-test-key-not-used-live"
  },
  "body": {
    "model": "anthropic/claude-opus-5-5",
    "max_tokens": 256,
    "messages": [
      {
        "role": "system",
        "content": "Return the schema only."
      },
      {
        "role": "user",
        "content": "Ping."
      }
    ],
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "connection_check",
        "strict": true,
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "title": "check",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "note": {
              "type": ["string", "null"],
              "description": "optional"
            },
            "choice": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": ["ok"]
        }
      }
    },
    "stream": false,
    "provider": {
      "order": ["anthropic"],
      "allow_fallbacks": false,
      "require_parameters": true,
      "data_collection": "deny"
    },
    "reasoning": {
      "effort": "low"
    }
  }
}
